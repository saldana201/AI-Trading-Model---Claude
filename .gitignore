# Confluence — AI Trading Model
#
# Replaces the Visual Studio C#/.NET template that shipped with this repo.
# That template never covered .next/, *.db, or Python bytecode, which is how
# ~61,000 build artifacts ended up tracked in git.
#
# Anything listed here that is ALREADY tracked stays tracked until you run
# `git rm --cached` on it — see the purge commands in the README.

# ---------------------------------------------------------------- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
sdist/
wheels/
*.egg-info/
*.egg
MANIFEST

# virtual environments
.venv/
venv/
ENV/
env/
.python-version

# test & type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ------------------------------------------------------- Node / Next.js ---
node_modules/
.pnp
.pnp.js
.yarn/
.next/
out/
.turbo/
.swc/
*.tsbuildinfo
next-env.d.ts

# package manager debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------- Runtime state & trade data ---
# The alert lifecycle store and outcome journal. These hold YOUR trade
# history — they are machine-local state, not source, and committing them
# is both repo bloat and a privacy leak.
*.db
*.db-journal
*.db-wal
*.db-shm
*.db.backup
*.sqlite
*.sqlite3
alerts.jsonl
*.jsonl

# Local Phase 12 configuration: account size, risk-per-trade, presets.
# Machine-specific. Commit confluence.example.json instead if you want a
# shared starting point.
confluence.json
confluence.json.tmp

# Local watchlist. watchlist.example.json IS tracked as the template.
watchlist.json
watchlist.json.tmp

# generated snapshots / dashboard exports
dashboard/data.json
dashboard/index.html

# ------------------------------------------------- Secrets & env files ---
# ANTHROPIC_API_KEY, CONFLUENCE_API_KEY, Discord webhook URLs.
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# ------------------------------------------------------- OS & editors ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~

# ------------------------------------------- Visual Studio (retained) ---
# Kept from the original template — this repo lives in a VS solution dir,
# so these still apply.
.vs/
[Dd]ebug/
[Rr]elease/
[Bb]in/
[Oo]bj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.userprefs
*.pidb
*.svclog
*.scc
